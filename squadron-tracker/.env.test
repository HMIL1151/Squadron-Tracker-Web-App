# Test-only Firebase config. Loaded automatically by `react-scripts test` (NODE_ENV=test).
#
# These values are FAKE and point at nothing. They exist only so that `getAuth()` in
# src/firebase/firebase.js does not throw `auth/invalid-api-key` at module-import time --
# that module runs on any import, so without this every test file that transitively touches
# it would crash before running.
#
# The test suite never contacts Firebase. Firestore is replaced by the in-memory fake in
# src/test/fakeFirestore.js. Safe to commit: no real project is referenced.

REACT_APP_FIREBASE_API_KEY=AIzaSyTEST0000000000000000000000000000000
REACT_APP_FIREBASE_AUTH_DOMAIN=squadron-tracker-test.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=squadron-tracker-test
REACT_APP_FIREBASE_STORAGE_BUCKET=squadron-tracker-test.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
