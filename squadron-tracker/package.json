{
  "name": "squadron-tracker",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.3",
    "chart.js": "^4.4.8",
    "dotenv": "^16.4.7",
    "file-saver": "^2.0.5",
    "firebase": "^11.5.0",
    "framer-motion": "^12.6.3",
    "jspdf": "^3.0.1",
    "jszip": "^3.10.1",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "react-modal": "^3.16.3",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^7.4.0",
    "react-scripts": "5.0.1",
    "react-tabs": "^6.1.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev:offline": "cross-env REACT_APP_USE_FAKE_DB=true react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:rules": "node scripts/test-rules.js",
    "eject": "react-scripts eject"
  },
  "jest": {
    "globalSetup": "<rootDir>/src/test/globalSetup.js",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/test/**",
      "!src/misc/**",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 69,
        "branches": 60,
        "functions": 69,
        "lines": 69
      },
      "src/utils/**/*.js": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "cross-env": "^10.1.0",
    "undici": "^6.28.0"
  }
}
