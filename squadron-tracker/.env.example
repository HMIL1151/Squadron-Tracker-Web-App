# Copy this file to `.env` and fill in the values for your Firebase project.
#
# Find them at:
#   Firebase Console -> Project settings -> General -> Your apps -> SDK setup and configuration
#
# These are Firebase *web* config values. They are public project identifiers, not secrets --
# they ship in the client bundle by design. Access control is enforced by Firebase Auth and the
# Firestore security rules in `firestore.rules`, never by hiding these values.
#
# `.env` is gitignored. Do not commit it.

REACT_APP_FIREBASE_API_KEY=your-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=000000000000
REACT_APP_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
